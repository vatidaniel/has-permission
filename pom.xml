<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.vatisteve</groupId>
    <artifactId>has-permission-parent</artifactId>
    <version>0.2.0</version>
    <packaging>pom</packaging>

    <name>has-permission-parent</name>
    <description>
        Parent aggregator for the has-permission permission-control library and its Spring Boot starter.
        The core module provides an annotation-driven (@HasPermission), Spring-AOP/SpEL based permission-checking
        mechanism; the starter module auto-configures it for Spring Boot applications.
    </description>
    <url>https://github.com/vatidaniel/has-permission</url>

    <modules>
        <module>core</module>
        <module>spring-boot-starter</module>
    </modules>

    <properties>
        <maven.compiler.source>11</maven.compiler.source>
        <maven.compiler.target>11</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <lombok.version>1.18.34</lombok.version>
        <slf4j.version>2.0.16</slf4j.version>
        <logback.version>1.5.18</logback.version>
        <spring.version>5.3.39</spring.version>
        <aspectj.version>1.9.23</aspectj.version>
        <spring-boot.version>2.7.18</spring-boot.version>
        <junit.version>5.11.4</junit.version>
        <mockito.version>5.16.1</mockito.version>
        <maven-compiler-plugin.version>3.13.0</maven-compiler-plugin.version>
        <maven-surefire-plugin.version>3.2.5</maven-surefire-plugin.version>
    </properties>

    <!--
      Note: dependency versions are intentionally NOT managed here. Maven gives parent-inherited
      dependencyManagement precedence over a child module's imported BOM, so pinning test/library
      versions in this parent would leak into (and conflict with) the Spring Boot BOM used by the
      starter module. Instead, the core module pins its own versions via the properties above, and
      the starter module derives everything from the Spring Boot BOM it imports locally.
    -->

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven-compiler-plugin.version}</version>
                    <configuration>
                        <source>${maven.compiler.source}</source>
                        <target>${maven.compiler.target}</target>
                        <!-- Retain method parameter names so SpEL "#paramName" subject
                             expressions resolve reliably (independent of debug info). -->
                        <parameters>true</parameters>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven-surefire-plugin.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <licenses>
        <license>
            <name>The MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <name>vatisteve</name>
            <email>vatisteve@gmail.com</email>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:git@github.com:vatidaniel/has-permission.git</connection>
        <developerConnection>scm:git:ssh://git@github.com:vatidaniel/has-permission.git</developerConnection>
        <url>https://github.com/vatidaniel/has-permission</url>
    </scm>

    <!--
      Publishing target is the Central Publisher Portal (https://central.sonatype.org/publish/publish-portal-maven).
      The legacy OSSRH endpoint (s01.oss.sonatype.org) was sunset on 2025-06-30, so no <distributionManagement>
      is declared: the central-publishing-maven-plugin (release profile below) uploads directly to the portal,
      authenticating against the <server id=central> entry in settings.xml.
    -->

    <profiles>
        <profile>
            <id>release</id>
            <activation>
                <property>
                    <name>performRelease</name>
                    <value>true</value>
                </property>
            </activation>
            <build>
                <plugins>
                    <!-- Central Publishing Plugin: aggregates the whole reactor into a single
                         deployment bundle and uploads it to the Central Publisher Portal. Must
                         live in <plugins> with extensions=true so it takes over the deploy phase;
                         authenticates against <server id=central> in settings.xml. autoPublish
                         releases automatically once validation passes. -->
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>0.10.0</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <autoPublish>true</autoPublish>
                            <waitUntil>published</waitUntil>
                        </configuration>
                    </plugin>
                    <!-- GPG Plugin for signing artifacts -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.0.1</version>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <!-- Javadoc Plugin for generating Javadoc JAR -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <version>3.2.0</version>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                            </execution>
                        </executions>
                        <configuration>
                            <javadocExecutable>${JAVA_HOME}/bin/javadoc</javadocExecutable>
                            <source>11</source>
                        </configuration>
                    </plugin>
                    <!-- Source Plugin for generating source JAR -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <version>3.2.1</version>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals>
                                    <goal>jar-no-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
